# Let static files serve normally (do NOT redirect)
/*.ico        /$1.ico        200
/*.png        /$1.png        200
/*.jpg        /$1.jpg        200
/*.svg        /$1.svg        200
/*.txt        /$1.txt        200
/*.xml        /$1.xml        200
/*.css        /$1.css        200
/*.js         /$1.js         200
/*.webmanifest /$1.webmanifest 200

# Sitemap - let it serve normally
/sitemap.xml  /sitemap.xml   200

# For all other routes (SPA routing), serve index.html
/*            /index.html    200
